<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClaudeTray"
        x:Class="ClaudeTray.SettingsWindow"
        x:DataType="local:SettingsViewModel"
        Title="Claude Tray Settings"
        Icon="/Assets/claude-tray.png"
        Width="640" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TabItem > ScrollViewer > StackPanel">
      <Setter Property="Margin" Value="20,16" />
      <Setter Property="Spacing" Value="12" />
    </Style>
  </Window.Styles>

  <TabControl TabStripPlacement="Left" Padding="0">

    <TabItem Header="Account">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Claude Code login" />
          <TextBlock Text="{Binding AuthTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AuthDetail}" Classes="dim" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding LoginText}" Command="{Binding LoginCommand}" Classes="accent" />
            <Button Content="{Binding LogoutText}" Command="{Binding LogoutCommand}" IsVisible="{Binding LoggedIn}" />
            <Button Content="Refresh" Command="{Binding RefreshAuthCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding AccountStatus}" Classes="dim" />
          <TextBlock Classes="dim" FontSize="12"
                     Text="Log in again switches the account or renews an expired login. It runs claude auth login in a terminal, which opens your browser." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Appearance">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Theme" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" MinWidth="200" />
          <TextBlock Classes="h" Text="Panel colours" Margin="0,8,0,0" />
          <TextBlock Classes="dim" FontSize="12" Text="Tick a colour to use your own instead of the theme's. Changes show in the panel right away." />
          <ItemsControl ItemsSource="{Binding Colors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ColorSetting">
                <Grid ColumnDefinitions="160,Auto" Margin="0,4">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Custom}" />
                  <ColorPicker Grid.Column="1" Color="{Binding Color}" IsAlphaEnabled="False" IsAlphaVisible="False" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Reset to theme colours" Command="{Binding ResetColorsCommand}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Support">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Need help?" />
          <TextBlock Classes="dim"
                     Text="Found a bug, have a question or an idea? Open an issue on GitHub. Please include your operating system and, for bugs, the log (About → Open log)." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open a GitHub issue" Command="{Binding IssueCommand}" Classes="accent" />
            <Button Content="Project on GitHub" Command="{Binding ProjectCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="About">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="{Binding Version}" />
          <TextBlock Classes="dim" Text="© Studer Works, LLC · MIT license" />
          <CheckBox Content="Check for new versions on GitHub" IsChecked="{Binding CheckForUpdates}" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" />
            <TextBlock Text="{Binding UpdateCheckStatus}" Classes="dim" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Settings file" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding ConfigPath}" Classes="dim" FontSize="12" />
          <Button Content="Open settings file" Command="{Binding OpenConfigCommand}"
                  ToolTip.Tip="Advanced settings (terminal commands, tmux, model list). Restart the app after editing." />
          <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding LogPath}" Classes="dim" FontSize="12" />
          <Button Content="Open log" Command="{Binding OpenLogCommand}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
