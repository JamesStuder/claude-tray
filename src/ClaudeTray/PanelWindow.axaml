<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClaudeTray"
        x:Class="ClaudeTray.PanelWindow"
        x:DataType="local:MainViewModel"
        Title="Claude Tray"
        Icon="/Assets/claude-tray.png"
        Width="880" Height="720"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="#E5484D" />
    </Style>
    <Style Selector="ProgressBar.meter">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="0,3,0,2" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#2E3E9BEA" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <DockPanel>

      <!-- header -->
      <Border DockPanel.Dock="Top" Padding="16,14,16,10"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="/Assets/claude-tray.png" Width="40" Height="40" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Claude Code" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Classes="dim" />
            </StackPanel>
          </StackPanel>
          <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error, StringFormat='⚠ {0}'}"
                     Foreground="#F5A524" TextWrapping="Wrap" />
          <Border IsVisible="{Binding UpdateAvailable}" Background="#263E9BEA" CornerRadius="6" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatus}" Classes="dim" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Grid.Column="1" Content="What's new" Command="{Binding ReleaseNotesCommand}" />
              <Button Grid.Column="2" Content="Update" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}" Classes="accent" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- footer -->
      <Border DockPanel.Dock="Bottom" Padding="12,8"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button Grid.Column="0" Content="⟳  Refresh" Command="{Binding RefreshCommand}" />
          <Button Grid.Column="1" Content="⚙  Settings" Command="{Binding SettingsCommand}" />
          <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="dim" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="6,0" />
          <Button Grid.Column="3" Content="Restart" IsVisible="{Binding CanRestart}" Command="{Binding RestartCommand}"
                  ToolTip.Tip="Restart Claude Code in its tmux pane and resume the same conversation" />
          <Button Grid.Column="4" Content="{Binding OpenText}" Command="{Binding OpenClaudeCommand}" Classes="accent" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="1.25*,1,*">

        <!-- left: background sessions -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,0,14,14">
            <TextBlock IsVisible="{Binding HasSessionsError}" Text="{Binding SessionsError}"
                       Foreground="#F5A524" TextWrapping="Wrap" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SessionGroupVM">
                  <StackPanel IsVisible="{Binding Visible}" Spacing="2">
                    <TextBlock Classes="section" Text="{Binding Header}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SessionVM">
                          <Border Classes="row" Tapped="SessionTapped">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Top" Margin="2,1,0,0"
                                         Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" />
                              <StackPanel Grid.Column="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Text="{Binding Ago}" Classes="dim" />
                                </Grid>
                                <TextBlock IsVisible="{Binding HasText}" Text="{Binding Text}" Classes="dim"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Button Grid.Column="2" Content="{Binding RemoveText}" Command="{Binding Remove}"
                                      ToolTip.Tip="{Binding RemoveTip}" VerticalAlignment="Top"
                                      Padding="8,2" Background="Transparent" BorderThickness="0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button IsVisible="{Binding ShowToggle}" Content="{Binding ToggleText}" Command="{Binding ToggleAll}"
                            FontSize="12" Background="Transparent" BorderThickness="0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding NoSessions}" Text="No background sessions" Classes="dim" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- right: usage -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,0,14,14">

            <TextBlock Classes="section" Text="LIMITS" IsVisible="{Binding HasLimits}" />
            <ItemsControl ItemsSource="{Binding Limits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LimitRow">
                  <StackPanel Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto,44" ColumnSpacing="6">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ResetIn}" Classes="dim" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Percent}" FontWeight="Bold" TextAlignment="Right"
                                 Classes.danger="{Binding High}" />
                    </Grid>
                    <ProgressBar Classes="meter" Value="{Binding Value}" Foreground="{Binding Brush}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="TOKENS BY DAY · THIS COMPUTER" />
            <ItemsControl ItemsSource="{Binding Days}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:DayRow">
                  <Grid ColumnDefinitions="48,*,64" ColumnSpacing="8" Margin="0,1">
                    <TextBlock Text="{Binding Name}" Classes.dim="{Binding !Today}" FontWeight="{Binding Today, Converter={x:Static local:Converters.BoldIf}}" />
                    <ProgressBar Grid.Column="1" Classes="meter" Value="{Binding Value}" VerticalAlignment="Center"
                                 Opacity="{Binding Today, Converter={x:Static local:Converters.FullIf}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" TextAlignment="Right"
                               FontWeight="{Binding Today, Converter={x:Static local:Converters.BoldIf}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="TOKENS BY MODEL · TODAY · THIS COMPUTER" IsVisible="{Binding HasModels}" />
            <ItemsControl ItemsSource="{Binding Models}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ModelRow">
                  <StackPanel Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding Total}" FontWeight="Bold" />
                    </Grid>
                    <ProgressBar Classes="meter" Value="{Binding Value}" />
                    <TextBlock Text="{Binding Split}" Classes="dim" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="PACE" IsVisible="{Binding HasLimits}" />
            <ItemsControl ItemsSource="{Binding Limits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LimitRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,1">
                    <TextBlock Text="{Binding Label}" Classes="dim" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Pace}" FontSize="12" Classes.danger="{Binding PaceWarn}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="{Binding ModelHeader}" />
            <ItemsControl ItemsSource="{Binding ModelChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ModelChoiceVM">
                  <ToggleButton Content="{Binding Name}" IsChecked="{Binding Current, Mode=OneWay}"
                                Command="{Binding Pick}" CommandParameter="{Binding Choice}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button IsVisible="{Binding ShowClearModel}" Content="Account default" Command="{Binding ClearModelCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0"
                    ToolTip.Tip="Remove the model setting: new sessions use your account's default model" />

            <Button Content="Usage on claude.ai ↗" Command="{Binding UsagePageCommand}" Margin="0,14,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
